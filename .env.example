# GOOGLE SIGN-IN
# OAuth client id used to VERIFY Google ID tokens server-side. Must match the
# client id the frontend renders the Google button with (this is the current
# production value and the code's built-in default).
GOOGLE_CLIENT_ID='13191319610-qectaoi146ce1pm4v95jtgctsbtmqb3t.apps.googleusercontent.com'

# RFAB BRIDGE (shared identity + shared token wallet with rfab.ai)
# Leave RFAB_BRIDGE_SECRET empty to run fully local - every bridge feature
# degrades gracefully and the site behaves exactly as before the bridge.
RFAB_BRIDGE_URL='https://api.rfab.ai'
RFAB_BRIDGE_SECRET=''
# Exchange rate: RFab tokens granted per institute token (migration grants and
# Stripe purchases by mapped users). DECISION PENDING (Collins) - default 1.
RFAB_TOKENS_PER_INSTITUTE_TOKEN=1

