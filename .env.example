# ChatGPT
OPENAI_API_KEY=

# Base url
BASE_URL='http://localhost:3000';

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=skill_tree
DB_USERNAME='relevant username'
DB_PASSWORD='relevant password'

# AWS S3
S3_SKILL_INFOBOX_IMAGE_BUCKET_NAME="bucket name"
S3_SKILL_INFOBOX_IMAGE_THUMBNAILS_BUCKET_NAME="bucket name"
S3_SKILL_ICON_BUCKET_NAME="bucket name"
S3_BUCKET_REGION="buckets' region"
S3_ACCESS_KEY_ID="access key"
S3_SECRET_ACCESS_KEY="secret access key"

#Gmail
# Gmail OAuth credentials
GMAIL_CLIENT_ID='Oauth ID'
GMAIL_CLIENT_SECRET='Oauth Secret'
GMAIL_REDIRECT_URI=''
GMAIL_REFRESH_TOKEN=''
GMAIL_ADDRESS=''

# CLIENT EDITOR ACCOUNT
MASTER_EDITOR_ACCOUNT='Client editor account'

# NOTIFICATION EMAIL ADDRESSES
NOTIFICATION_GMAIL_RECEIVER='gmail address use to get notification email'

# STRIPE
STRIPE_API_KEY=''
STRIPE_200000_TOKENS_PRICE_ID = ''
STRIPE_400000_TOKENS_PRICE_ID = ''
STRIPE_1000000_TOKENS_PRICE_ID = ''
STRIPE_2000000_TOKENS_PRICE_ID = ''
STRIPE_5000000_TOKENS_PRICE_ID = ''

# VECTOR STORE WITH DOCS FOR SPECIAL SKILLS
VECTOR_STORE_ID=''

# ------------------------------------------------------------------
# SECURITY / SESSION  (added in security hardening pass)
# ------------------------------------------------------------------
# REQUIRED in production — the app refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=''
# Comma-separated allow-list of browser origins (leave empty to reflect origin).
ALLOWED_ORIGINS='https://wizling.ai,https://parrhesia.io'
# Max request body size (base64 images ride inside JSON). Default 15mb.
BODY_LIMIT='15mb'
# Google Sign-In client id — used to verify the audience of Google credentials.
# Falls back to GMAIL_CLIENT_ID if unset. Set this to your Sign-In client id.
GOOGLE_CLIENT_ID=''
# Hard cap on decoded upload size in bytes (default 5MB).
S3_MAX_IMAGE_BYTES='5242880'

# ------------------------------------------------------------------
# STRIPE WEBHOOK  (payments now fulfilled via webhook, not the success URL)
# ------------------------------------------------------------------
# From the Stripe dashboard webhook endpoint (…/tokens/webhook).
STRIPE_WEBHOOK_SECRET=''

# ------------------------------------------------------------------
# RFab INTEGRATION
# ------------------------------------------------------------------
# Shared RFab OpenAI key — when set, all LLM/TTS/STT calls bill to this key
# instead of OPENAI_API_KEY above.
RFAB_OPENAI_API_KEY=''
# RFab usage-event sink (tracking only — no account/wallet coupling). Leave
# empty to disable emission entirely (the tracker becomes a no-op).
RFAB_USAGE_EVENTS_URL=''
RFAB_USAGE_EVENTS_KEY=''

# ------------------------------------------------------------------
# GROK (xAI) — the tutors now run on Grok with live web search + streaming.
# ------------------------------------------------------------------
# Same key RFab uses; populate from RFab's param store /rfab/prod/GROK_API_KEY.
GROK_API_KEY=''
GROK_MODEL='grok-4.5-latest'          # latest flagship; matches RFab's GrokProvider
GROK_BASE_URL='https://api.x.ai/v1'
GROK_WEB_SEARCH='true'                # set 'false' if the SDK rejects the web_search tool
GROK_MAX_HISTORY_TURNS='20'           # how many prior turns to replay per request

# ------------------------------------------------------------------
# AI MODELS  (OpenAI — still used for grading/marking/TTS/STT/embeddings;
# xAI does not provide those. INSTITUTE_TUTOR_MODEL is now UNUSED — tutors
# run on GROK_MODEL above.)
# ------------------------------------------------------------------
INSTITUTE_TUTOR_MODEL='gpt-4.1'
INSTITUTE_GRADING_MODEL='gpt-4.1'
INSTITUTE_MARKING_MODEL='gpt-4.1'
INSTITUTE_RECOMMEND_MODEL='gpt-4.1'
INSTITUTE_EMBEDDING_MODEL='text-embedding-3-small'
INSTITUTE_TTS_MODEL='tts-1'
INSTITUTE_TTS_VOICE='alloy'
INSTITUTE_STT_MODEL='whisper-1'

# Balance enforcement: 'enforce' (block when out of tokens) or 'log' (log only,
# safe first rollout — nothing is blocked). Default 'enforce'.
AI_BALANCE_ENFORCEMENT='enforce'

